# --------------------------------------------------------------------------- #
# Dockerfile.ubi — MemPalace CLI on Red Hat UBI 9 / Python 3.12
# --------------------------------------------------------------------------- #
# Runtime model : CLI / Job (no network port)
# ML workload   : yes — ChromaDB + onnxruntime (CPU-only)
# OpenShift     : arbitrary-UID safe (group 0 permissions, USER 1001)
# --------------------------------------------------------------------------- #
FROM registry.access.redhat.com/ubi9/python-312

# ---- Build-time labels ---------------------------------------------------- #
LABEL name="mempalace" \
      summary="Give your AI a memory — mine projects and conversations into a searchable palace" \
      version="3.3.5" \
      io.k8s.display-name="mempalace" \
      io.openshift.tags="ai,memory,llm,chromadb,cli"

# ---- System dependencies -------------------------------------------------- #
# Switch to root for package installation
USER 0

# gcc + python3-devel are needed to compile native wheels (e.g. chroma-hnswlib).
RUN dnf install -y \
        gcc \
        gcc-c++ \
        python3-devel \
    && dnf clean all

USER 1001

# ---- Application directory ------------------------------------------------ #
WORKDIR /opt/app-root/src

# ---- Install Python dependencies ------------------------------------------ #
# Pre-install onnxruntime CPU-only variant (NOT onnxruntime-gpu)
RUN pip install --no-cache-dir onnxruntime

# Install pysqlite3-binary to provide a modern SQLite (>= 3.35.0) that
# ChromaDB requires.  The UBI9 system SQLite is too old.
RUN pip install --no-cache-dir pysqlite3-binary

# Patch Python's sqlite3 module so that ChromaDB (and anything else that
# does ``import sqlite3``) transparently picks up the newer bundled
# pysqlite3 instead of the system library.
RUN SITE=$(python -c "import sysconfig; print(sysconfig.get_path('purelib'))") && \
    echo "# sqlite3 shim — redirect to pysqlite3 (modern SQLite for ChromaDB)" > "${SITE}/sqlite3_shim.pth" && \
    echo "import sys; sys.modules['sqlite3'] = __import__('pysqlite3')" >> "${SITE}/sqlite3_shim.pth"

# Copy dependency manifests + README (required by pyproject.toml build) first
# for better layer caching.
COPY pyproject.toml README.md ./

# Copy full source tree (including mempalace/ package dir)
COPY . .

# Install the project from source
RUN pip install --no-cache-dir .

# ---- Pre-cache the default embedding model -------------------------------- #
# ChromaDB's default embedding function (all-MiniLM-L6-v2 via onnxruntime)
# downloads the model on first use. Warm it up at build time so the container
# starts without needing network access.
# Use a temporary directory for the warmup ChromaDB data so it doesn't leave
# stale state in the working directory or palace path.
RUN python -c "\
import tempfile, os; \
tmpdir = tempfile.mkdtemp(); \
import chromadb; \
c = chromadb.PersistentClient(path=os.path.join(tmpdir, 'warmup')); \
c.get_or_create_collection('warmup'); \
" && rm -rf /tmp/tmp*

# ---- Palace data directory ------------------------------------------------ #
# The app defaults to ~/.mempalace (= /opt/app-root/.mempalace).
# Set MEMPALACE_PALACE_PATH so all commands use a consistent, writable path.
# Create directories for palace data, config, and ONNX model cache.
# Mount a PVC at /opt/app-root/.mempalace in production to persist across runs.
ENV MEMPALACE_PALACE_PATH=/opt/app-root/.mempalace/palace

USER 0
RUN mkdir -p /opt/app-root/.mempalace/palace \
             /opt/app-root/.cache \
    && chgrp -R 0 /opt/app-root \
    && chmod -R g=u /opt/app-root
USER 1001

# ---- Entrypoint ----------------------------------------------------------- #
# CLI tool — container acts as the `mempalace` command.
# Running with no args shows usage (--help).
ENTRYPOINT ["mempalace"]
CMD ["--help"]
